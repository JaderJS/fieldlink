{
	"name": "fieldlink",
	"module": "index.ts",
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "^1.4.3"
	},
	"private": true,
	"scripts": {
		"dev": "bun run --filter @fieldlink/server --filter @fieldlink/front dev",
		"dev:server": "bun run --filter @fieldlink/server dev",
		"dev:business": "bun run --filter business dev",
		"build": "bun run --filter '*' build",
		"business:start": "bun run --filter business start",
		"business:build": "bun run --filter business build",
		"business:dev": "bun run --filter business dev",
		"dashboard:dev": "bun run --filter @fieldlink/front dev",
		"dashboard:build": "bun run --filter dashboard build",
		"front:build": "bun run --filter @fieldlink/front build",
		"front:dev": "bun run --filter @fieldlink/front dev",
		"front:start": "bun run --filter @fieldlink/front start"
	},
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
