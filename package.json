    "dashboard:dev": "bun run --filter dashboard dev",
    "dashboard:build": "bun run --filter dashboard build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "dashboard>zod": "3.25.76",
    "dashboard>@hookform/resolvers": "3.10.0"
  }
}